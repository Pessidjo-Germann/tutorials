<odoo>

    <!-- ====================================================== -->
    <!--          1. LES VUES (LES CADRES)                      -->
    <!-- ====================================================== -->

    <!-- Vue Liste -->
    <record id="estate_property_view_tree" model="ir.ui.view">
        <!-- On ajoute un <field name="name"> pour la clarté -->
        <field name="name">estate.property.tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <tree string="Estate Properties">
                <field name="name"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area (sqm)"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability"/> 
            </tree>
        </field>
    </record>

    <!-- Vue Formulaire (nettoyée) -->
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
               <sheet>
                   <div class="oe_title">
                       <h1><field name="name" placeholder="Ex: Villa sur la côte"/></h1>
                   </div>
                   <group>
                        <group>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                        </group>
                   </group>
                   <notebook>
                       <page string="Description">
                           <group>
                               <field name="description"/>
                               <field name="bedrooms"/>
                               <field name="living_area" string="Living Area (sqm)"/>
                           </group>
                           <group>
                               <field name="garage"/>
                               <field name="garden"/>
                           </group>
                       </page>
                   </notebook>
               </sheet>
            </form>
        </field>
    </record>

    <!-- Vue Recherche -->
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
            <field name="name" string="Title"/>
             <filter name="filter_by_postcode" string="Postcode"/>
            <filter name="filter_by_expected_price" string="Expected Price" />
            <filter name="filter_by_bedrooms" string="Bedrooms" />
            <filter name="filter_by_living_area" string="Living Area (sqm)" />
            <filter name="filter_by_state" string="State" domain=[('state','=','New'),('state','=','Offer Received')] />
            
            <group expand="0" string="Grouper Par">
                <filter name="group_by_postcode" 
                        string="PostCode"
                        context="{'group_by': 'postcode'}"/>
            </group>
            </search>
        </field>
    </record>


    <!-- ====================================================== -->
    <!--          2. L'ACTION (LE PANNEAU INDICATEUR)           -->
    <!--          ON LA DÉCLARE AVANT LES LIENS QUI L'UTILISENT -->
    <!-- ====================================================== -->
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">tree,form</field>
        <!-- On lie directement la vue de recherche ici, c'est plus simple -->
        <field name="search_view_id" ref="estate_property_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_create">
                Click here to create your first property.
            </p>
        </field>
    </record>

    <!-- Plus besoin des ir.actions.act_window.view car Odoo saura trouver
         les vues tree et form grâce à leur champ "model".
         On les garde si on veut un contrôle absolu ou si on a plusieurs vues
         du même type pour le même modèle.
         Pour l'apprentissage, c'est bien de les avoir écrites,
         mais dans ce cas simple, elles sont optionnelles. -->

</odoo>