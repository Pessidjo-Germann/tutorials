<odoo>
  <record id="estate_property_action" model="ir.actions.act_window">
    <field name="name">test estate</field>
    <field name="res_model">estate.property</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
          <p class="o_view_nocontent_create">
            Cliquez ici pour créer votre première tâche.
          </p>
    </field>
  </record>
  <record id="estate_property_view_tree" model="ir.ui.view">
    <field name="model">estate.property</field>
     <field name="arch" type="xml">
    <tree string="estate">
        <field name="name"/>
        <field name="postcode"/>
        <field name="bedrooms"/>
        <field name="living_area" string="Living Area(sqm)"/>
        <field name="expected_price"/>
        <field name="selling_price"/>
        <field name="date_availability" string="Availabe From"/> 
    </tree>
    </field>
  </record>

<record id="estate_property_view_form" model="ir.ui.view">
          <field name="name">estate_property.view.form</field>
          <field name="model">estate.property</field>
          <field name="arch" type="xml">
            <form string="estate">
            <header>
            <button name="create" type="object"/>
            </header>
               <sheet>
                <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Titre de la tâche..."/>
                        </h1>
                    </div>
               </sheet>
               <sheet>
                <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Titre de la tâche..."/>
                        </h1>
                    </div>
               </sheet>
               <group>
                <field name="postcode" />
                <field name="bedrooms" />
               </group>
            </form>
          </field>
</record>

<record id="action_estate_form_view" model="ir.actions.act_window.view">
  <field name="act_window_id" ref="estate_property_action"/>
  <field name="view_mode">form</field>
  <field name="view_id" ref="estate_property_view_form"/>
  <field name="sequence">2</field>
</record>

<record id="action_estate_tree_view" model="ir.actions.act_window.view">
  <field name="act_window_id" ref="estate_property_action"/>
  <field name="view_mode">tree</field>
  <field name="view_id" ref="estate_property_view_tree"/>
  <field name="sequence">1</field>
</record>
 <menuitem id="menu_tasks_root" name="Gestionnaire"/>

     <menuitem id="menu_simple_task_list"
              name="Toutes les Tâches"
              parent="menu_tasks_root"
              action="estate_property_action"
              sequence="10"/>
</odoo>
